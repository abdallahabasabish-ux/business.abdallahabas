rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function userProfileRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '');
    }

    function isAdmin() {
      return signedIn() && (
        role() == 'admin'
        || request.auth.token.get('admin', false) == true
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && userProfileRole() in ['admin', 'مدير'])
      );
    }

    function isAccountant() {
      return signedIn() && (
        role() == 'accountant'
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && userProfileRole() == 'محاسب')
      );
    }

    function isEmployee() {
      return signedIn() && (
        role() == 'employee'
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && userProfileRole() in ['مشرف', 'موظف'])
      );
    }

    function isClient() {
      return signedIn() && (
        role() == 'client'
        || firestore.exists(/databases/(default)/documents/customers/$(request.auth.uid))
      );
    }

    function validImageOrPdf(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && (
          request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
          || request.resource.contentType == 'application/pdf'
        );
    }

    function validDocument(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && (
          request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType.matches('application/vnd\\.openxmlformats.*')
        );
    }

    function orderData(orderId) {
      return firestore.get(/databases/(default)/documents/orders/$(orderId)).data;
    }

    function taskData(taskId) {
      return firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
    }

    function conversationData(conversationId) {
      return firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
    }

    match /receipts/{customerUid}/{fileName=**} {
      allow read: if signedIn()
        && (customerUid == request.auth.uid || isAdmin() || isAccountant());
      allow create, update: if isClient()
        && customerUid == request.auth.uid
        && validImageOrPdf(5 * 1024 * 1024);
      allow delete: if isAdmin() || customerUid == request.auth.uid;
    }

    match /order-attachments/{orderId}/{fileName=**} {
      allow read: if signedIn() && (
        isAdmin()
        || isAccountant()
        || (isClient() && orderData(orderId).get('customerUid', '') == request.auth.uid)
        || (isClient() && orderData(orderId).get('customerId', '') == request.auth.uid)
        || (isEmployee() && orderData(orderId).get('assignedEmployeeIds', []).hasAny([request.auth.uid]))
      );
      allow create, update: if validDocument(10 * 1024 * 1024)
        && (isAdmin()
          || (isEmployee()
            && orderData(orderId).get('assignedEmployeeIds', []).hasAny([request.auth.uid])));
      allow delete: if isAdmin();
    }

    match /task-attachments/{taskId}/{fileName=**} {
      allow read: if isAdmin()
        || (isEmployee() && taskData(taskId).get('assignedEmployeeIds', []).hasAny([request.auth.uid]));
      allow create, update: if validDocument(10 * 1024 * 1024)
        && (isAdmin()
          || (isEmployee()
            && taskData(taskId).get('assignedEmployeeIds', []).hasAny([request.auth.uid])));
      allow delete: if isAdmin();
    }

    match /message-attachments/{conversationId}/{fileName=**} {
      allow read: if signedIn() && (
        isAdmin()
        || conversationData(conversationId).get('customerUid', '') == request.auth.uid
        || conversationData(conversationId).get('employeeUid', '') == request.auth.uid
      );
      allow create, update: if signedIn()
        && (isAdmin()
          || conversationData(conversationId).get('customerUid', '') == request.auth.uid
          || conversationData(conversationId).get('employeeUid', '') == request.auth.uid)
        && validDocument(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /company/{fileName=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
