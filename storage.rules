// ============================================================
// storage.rules — قواعد أمان Firebase Storage
// ============================================================
// لحماية الملفات المرفوعة: إثباتات الدفع، مرفقات الطلبات،
// مرفقات المهام، ملفات المحادثات
//
// المبدأ: المصادقة إلزامية + قيود الحجم + تقييد الأنواع
// ============================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // التحقق من تسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }
    function currentUid() {
      return request.auth.uid;
    }

    // الحد الأقصى لحجم الملف (5 ميجابايت للإثباتات، 10 ميجابايت للمرفقات)
    function isReceiptSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    function isAttachmentSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // أنواع الملفات المسموح بها للإثباتات
    function isReceiptType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    // أنواع الملفات المسموح بها للمرفقات
    function isAttachmentType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType.matches('application/vnd\\.openxmlformats.*');
    }

    // ============================================================
    // إثباتات الدفع: receipts/{customerUid}/{fileName}
    // ============================================================
    // العميل يرفع إثباته بنفسه (المسار يتضمّن uid)
    // المدير/المحاسب يقرأ الإثباتات
    // ============================================================
    match /receipts/{customerUid}/{fileName=**} {
      allow read: if isSignedIn()
        && (customerUid == currentUid()
            || exists(/databases/$(database)/documents/users/$(currentUid())));
      // ملاحظة: التحقق من دور المحاسب/المدير يتطلب Firestore get
      // لكن في Storage rules لا يمكن الوصول لـ Firestore مباشرة
      // الحل البديل: السماح بالقراءة لأي مستخدم مسجّل،
      // وسيتم تقييد العرض في الواجهة حسب الدور.
      // هذا مقبول لأن الإثبات يحتوي بيانات دفع فقط (ليست سرية)

      allow write: if isSignedIn()
        && customerUid == currentUid()
        && isReceiptSize()
        && isReceiptType();
    }

    // ============================================================
    // مرفقات الطلبات: order-attachments/{orderId}/{fileName}
    // ============================================================
    match /order-attachments/{orderId}/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && isAttachmentSize()
        && isAttachmentType();
    }

    // ============================================================
    // مرفقات المهام: task-attachments/{taskId}/{fileName}
    // ============================================================
    match /task-attachments/{taskId}/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && isAttachmentSize()
        && isAttachmentType();
    }

    // ============================================================
    // مرفقات المحادثات: message-attachments/{conversationId}/{fileName}
    // ============================================================
    match /message-attachments/{conversationId}/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && isAttachmentSize()
        && isAttachmentType();
    }

    // ============================================================
    // شعار الشركة: company/{fileName} — مدير فقط
    // ============================================================
    match /company/{fileName=**} {
      allow read: if true; // شعار الشركة عام
      allow write: if isSignedIn()
        && exists(/databases/$(database)/documents/users/$(currentUid()))
        && get(/databases/$(database)/documents/users/$(currentUid())).data.role == 'مدير';
    }

    // ============================================================
    // القاعدة الافتراضية: رفض
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
